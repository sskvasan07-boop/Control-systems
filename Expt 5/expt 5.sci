clear; clc;
Mp=0.2; tp=1; J=1; B=1;
zeta=-log(Mp)/sqrt(%pi^2+log(Mp)^2);
wd=%pi/tp;
wn=wd/sqrt(1-zeta^2);
K=J*wn^2;
Kh=(2*zeta*sqrt(K*J)-B)/K;
sigma=zeta*wn;
beta=atan(wd/sigma);
disp(zeta,"zeta=");
disp(wd,"damped frequency wd=");
disp(wn,"natural frequency wn=");
disp(K,"K=");
disp(Kh,"Kh=");
disp(sigma,"sigma=");
disp(beta,"Beta=");
disp((%pi-beta)/wd,"Rise time tr=");
disp(4/sigma,"Settling time for 2% error=");
disp(3/sigma,"Settling time for 5% error=");
