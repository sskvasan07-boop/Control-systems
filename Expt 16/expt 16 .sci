clc;
clear;
A = [0 1; -0.4 -1.3];
B = [0;1];
C = [0.8 1];
D = 0;
G1 = syslin('c',A,B,C,D);
ssprint(G1);
G2 = syslin('c',A',C',B',D);
ssprint(G2);
Cc1 = cont_mat(A,B);
disp(Cc1,"state controllability matrix1=");
disp(det(Cc1),"det(Cc1)=");
Ob1 = obsv_mat(A,C);
disp(Ob1,"observability matrix1=");
disp(det(Ob1),"det(Ob1)=");
Cc2 = cont_mat(A',C');
disp(Cc2,"state controllability matrix2=");
disp(det(Cc2),"det(Cc2)=");
Ob2 = obsv_mat(A',B');
disp(Ob2,"observability matrix2=");
disp(det(Ob2),"det(Ob2)=");
Htf = clean(ss2tf(G1));
disp(Htf,"Reduced transfer function=");
e = spec(A);
disp(e,"Eigen values=");
P = poly(e,'s');
disp(P,"actual denominator (characteristic poly)=");
